{
  "name": "dsh-plugin-bio-thesis",
  "version": "0.3.0",
  "description": "Start a Word thesis from your university's template, audit an existing draft, and export a 65-item review checklist in DeepSeek Harness.",
  "author": "Spark-xY6",
  "homepage": "https://github.com/Spark-xY6/dsh-plugin-bio-thesis#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Spark-xY6/dsh-plugin-bio-thesis.git" },
  "bugs": { "url": "https://github.com/Spark-xY6/dsh-plugin-bio-thesis/issues" },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "docx",
    "thesis",
    "dissertation",
    "bioinformatics",
    "academic-formatting"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./presets/*.json": "./presets/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "lib",
    "src",
    "skills",
    "presets",
    "pyproject.toml",
    "README.md",
    "README.zh.md",
    "docs",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-skill": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  }
}
